<dialog class="promo-dialog" aria-label="סרטון הדף השבועי">
  <button type="button" class="promo-close" aria-label="סגירת הסרטון">
    ✕
  </button>
  <video
    controls
    playsinline
    preload="none"
    aria-label="היכרות עם הדף השבועי"
  ></video>
  <p class="promo-error" role="alert" hidden>
    הסרטון לא נטען. אפשר לנסות שוב בפתיחה הבאה.
  </p>
</dialog>
<style>
  .promo-dialog {
    width: min(960px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 20px;
    background: var(--blue-d);
    overflow: auto;
    box-shadow: var(--sh-3);
  }
  .promo-dialog::backdrop {
    background: rgba(11, 37, 80, 0.72);
    backdrop-filter: blur(6px);
  }
  .promo-dialog[open] {
    animation: promo-enter 240ms var(--ease) both;
  }
  .promo-dialog video {
    display: block;
    width: 100%;
    max-height: calc(100dvh - 32px);
  }
  .promo-close {
    position: absolute;
    top: 12px;
    inset-inline-end: 12px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    background: var(--surface);
    color: var(--blue-d);
    font: inherit;
    cursor: pointer;
    z-index: 1;
  }
  .promo-close:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
  }
  .promo-error {
    padding: 16px;
    color: white;
    margin: 0;
  }
  @keyframes promo-enter {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .promo-dialog[open] {
      animation: none;
    }
  }
</style>
<script>
  const dialog = document.querySelector<HTMLDialogElement>(".promo-dialog");
  const trigger = document.querySelector<HTMLAnchorElement>(
    ".site-header .brand",
  );
  if (dialog && trigger) {
    const video = dialog.querySelector<HTMLVideoElement>("video")!;
    const error = dialog.querySelector<HTMLElement>(".promo-error")!;
    const prepare = () => {
      if (!video.getAttribute("src")) {
        video.preload = "metadata";
        video.src = "/promo/hadaf-promo.mp4";
      }
    };
    trigger.setAttribute("aria-label", "צפייה בסרטון הדף השבועי");
    trigger.addEventListener("pointerenter", prepare, { once: true });
    trigger.addEventListener("focus", prepare, { once: true });
    trigger.addEventListener("click", (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
        return;
      event.preventDefault();
      error.hidden = true;
      prepare();
      dialog.showModal();
      if (video.error) video.load();
      void video.play().catch(() => undefined);
    });
    dialog
      .querySelector("button")!
      .addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target !== dialog) return;
      const bounds = dialog.getBoundingClientRect();
      if (
        event.clientX < bounds.left ||
        event.clientX > bounds.right ||
        event.clientY < bounds.top ||
        event.clientY > bounds.bottom
      )
        dialog.close();
    });
    dialog.addEventListener("close", () => {
      video.pause();
      trigger.focus();
    });
    video.addEventListener("error", () => {
      error.hidden = false;
    });
  }
</script>
