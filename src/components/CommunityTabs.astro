<section
  class="community container"
  aria-label="עדכונים מהדף השבועי"
  data-community-tabs
>
  <div
    class="community-tabs"
    role="tablist"
    aria-label="איך מקבלים עדכונים"
    hidden
  >
    <button
      id="community-whatsapp-tab"
      type="button"
      role="tab"
      aria-controls="community-whatsapp"
      aria-selected="true"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        aria-hidden="true"
      >
        <path d="M21 11.5a9 9 0 0 1-13.5 7.8L3 21l1.7-4.5A9 9 0 1 1 21 11.5Z" />
        <path d="M8 9h8M8 13h5" />
      </svg>
      קבוצת הוואטסאפ
    </button>
    <button
      id="community-reminders-tab"
      type="button"
      role="tab"
      aria-controls="community-reminders"
      aria-selected="false"
      tabindex="-1"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        aria-hidden="true"
      >
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4M12 2V1" />
      </svg>
      עדכונים ותזכורות
    </button>
  </div>
  <div
    id="community-whatsapp"
    class="community-panel"
    role="tabpanel"
    aria-labelledby="community-whatsapp-tab"
    tabindex="0"
  >
    <div>
      <p class="community-kicker">הדף של השבוע, ישר לוואטסאפ</p>
      <h2>נשארים בעניינים</h2>
      <p>עדכוני התוכנית והשאלון השבועי בקבוצה השקטה של הדף השבועי.</p>
    </div>
    <div class="community-action">
      <a
        class="button button-whatsapp"
        data-community
        hidden
        target="_blank"
        rel="noopener"
      >
        מצטרפים לקבוצה <span aria-hidden="true">↗</span>
      </a>
      <p data-community-status role="status">
        טוענים את קישור הקבוצה…
      </p>
      <noscript>
        <p>להצגת קישור הקבוצה, יש להפעיל JavaScript.</p>
      </noscript>
    </div>
  </div>
  <div
    id="community-reminders"
    class="community-panel"
    role="tabpanel"
    aria-labelledby="community-reminders-tab"
    tabindex="0"
  >
    <div>
      <p class="community-kicker">התזכורת שלכם ללימוד</p>
      <h2>זוכרים לפתוח את הדף</h2>
      <p>מדריך קצר להפעלת ההתראות במכשיר ובדיקה שהן מגיעות.</p>
    </div>
    <div class="community-action">
      <a class="button button-gold" href="/hitraot">
        הגדרת התראות <span aria-hidden="true">←</span>
      </a>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-community-tabs]");
  if (root) {
    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
    );
    const panels = Array.from(
      root.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
    );
    function select(index: number, focus = false) {
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        panels[i].hidden = i !== index;
      });
      if (focus) tabs[index].focus();
    }
    root.querySelector<HTMLElement>('[role="tablist"]')!.hidden = false;
    select(0);
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(index));
      tab.addEventListener("keydown", (event) => {
        let next: number;
        if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        else if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
          const rtl = getComputedStyle(root).direction === "rtl";
          const forward = event.key === (rtl ? "ArrowLeft" : "ArrowRight");
          next = (index + (forward ? 1 : -1) + tabs.length) % tabs.length;
        } else return;
        event.preventDefault();
        select(next, true);
      });
    });
  }
</script>

<style>
  .community {
    margin-block: 32px 56px;
    border: 1px solid var(--rule);
    border-radius: 20px;
    overflow: clip;
    background: var(--surface);
    box-shadow: var(--sh-1);
  }
  .community-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 6px;
    gap: 6px;
    background: var(--sunk);
    border-bottom: 1px solid var(--rule);
  }
  .community-tabs button {
    min-height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 0;
    border-radius: 13px;
    background: transparent;
    color: var(--ink-2);
    font-weight: 750;
    transition:
      background 0.2s,
      color 0.2s,
      box-shadow 0.2s;
  }
  .community-tabs button[aria-selected="true"] {
    background: var(--blue-d);
    color: var(--surface);
    box-shadow: var(--sh-1);
  }
  #community-whatsapp-tab[aria-selected="true"] {
    background: var(--green-d);
  }
  #community-whatsapp .community-kicker {
    color: var(--green-d);
  }
  .button-whatsapp {
    background: var(--green-d);
    border-color: var(--green-d);
    color: #fff;
  }
  .button-whatsapp:hover {
    background: #386615;
    border-color: #386615;
  }
  .community-tabs svg {
    width: 22px;
    height: 22px;
    flex: none;
  }
  .community-panel {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 28px;
    padding: 36px;
    animation: community-enter 0.24s var(--ease);
  }
  .community-kicker {
    color: var(--gold-t);
    font-size: 0.8rem;
    font-weight: 750;
    margin: 0 0 8px;
  }
  .community-panel h2 {
    margin: 0 0 10px;
    font-size: clamp(1.45rem, 3vw, 1.9rem);
  }
  .community-panel p:not(.community-kicker) {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.95rem;
    max-width: 48ch;
  }
  .community-action .button {
    gap: 14px;
    white-space: nowrap;
  }
  .community-action [role="status"] {
    font-size: 0.8rem;
  }
  .community [hidden] {
    display: none;
  }
  .community :is(button, a, [role="tabpanel"]):focus-visible {
    outline: 3px solid var(--blue-l);
    outline-offset: 3px;
  }
  @keyframes community-enter {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (max-width: 700px) {
    .community {
      margin-block: 24px 40px;
      border-radius: 16px;
    }
    .community-tabs {
      padding: 5px;
      gap: 4px;
    }
    .community-tabs button {
      min-height: 62px;
      flex-direction: column;
      gap: 4px;
      font-size: 0.8rem;
      padding: 8px 4px;
    }
    .community-tabs svg {
      width: 20px;
      height: 20px;
    }
    .community-panel {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 24px 20px;
      min-height: 244px;
    }
    .community-action .button {
      width: 100%;
      justify-content: space-between;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .community-panel {
      animation: none;
    }
    .community-tabs button {
      transition: none;
    }
  }
  :global(html:not(.js)) [data-community-status] {
    display: none;
  }
</style>
