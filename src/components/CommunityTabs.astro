---
import "../styles/community.css";
---

<section
  class="community container"
  aria-label="עדכונים מהדף השבועי"
  data-community-tabs
  data-reveal
>
  <div
    class="community-tabs"
    role="tablist"
    aria-label="איך מקבלים עדכונים"
    hidden
  >
    <button
      id="community-whatsapp-tab"
      type="button"
      role="tab"
      aria-controls="community-whatsapp"
      aria-selected="true"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        aria-hidden="true"
      >
        <path d="M21 11.5a9 9 0 0 1-13.5 7.8L3 21l1.7-4.5A9 9 0 1 1 21 11.5Z" />
        <path d="M8 9h8M8 13h5" />
      </svg>
      קבוצת הוואטסאפ
    </button>
    <button
      id="community-reminders-tab"
      type="button"
      role="tab"
      aria-controls="community-reminders"
      aria-selected="false"
      tabindex="-1"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        aria-hidden="true"
      >
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4M12 2V1" />
      </svg>
      עדכונים ותזכורות
    </button>
  </div>
  <div
    id="community-whatsapp"
    class="community-panel"
    role="tabpanel"
    aria-labelledby="community-whatsapp-tab"
    tabindex="0"
  >
    <div class="community-heading">
      <div class="community-copy">
        <p class="community-kicker">הדף של השבוע, ישר לוואטסאפ</p>
        <h2>נשארים בעניינים</h2>
        <p>עדכוני התוכנית והשאלון השבועי בקבוצה השקטה של הדף השבועי.</p>
      </div>
      <button
        type="button"
        class="community-confirm"
        data-community-confirm
        aria-label="כבר בקבוצה"
        title="כבר בקבוצה"
        hidden
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9" />
          <path d="m7.5 12 3 3 6-6" />
        </svg>
      </button>
    </div>
    <div class="community-action">
      <a
        class="button button-whatsapp"
        data-community
        hidden
        target="_blank"
        rel="noopener"
      >
        מצטרפים לקבוצה <span aria-hidden="true">↗</span>
      </a>
      <p data-community-status role="status">
        טוענים את קישור הקבוצה…
      </p>
      <noscript>
        <p>להצגת קישור הקבוצה, יש להפעיל JavaScript.</p>
      </noscript>
    </div>
  </div>
  <div
    id="community-reminders"
    class="community-panel"
    role="tabpanel"
    aria-labelledby="community-reminders-tab"
    tabindex="0"
  >
    <div class="community-heading">
      <div class="community-copy">
        <p class="community-kicker">התזכורת שלכם ללימוד</p>
        <h2>זוכרים לפתוח את הדף</h2>
        <p>מדריך קצר להפעלת ההתראות במכשיר ובדיקה שהן מגיעות.</p>
      </div>
    </div>
    <div class="community-action">
      <button
        type="button"
        class="button button-gold"
        data-community-enable
        hidden
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4" />
        </svg>
        <span>הפעלת התראות</span>
      </button>
      <a class="button button-gold" href="/hitraot" data-community-help>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9" />
          <path d="M9 9a3 3 0 0 1 6 0c0 2-3 2-3 4M12 16v1" />
        </svg>
        <span>הגדרת התראות</span>
      </a>
      <p data-community-notification-status role="alert" hidden></p>
    </div>
  </div>
</section>

<script>
  import {
    communityGroup,
    groupJoined,
    confirmGroup,
    remindersEnabled,
  } from "../lib/community";
  import { enableReminders } from "../lib/notifications";
  import { stored, type Person } from "../lib/client";
  import { updateCommunity } from "../lib/community-motion";
  const root = document.querySelector<HTMLElement>("[data-community-tabs]");
  if (root) {
    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
    );
    const panels = Array.from(
      root.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
    );
    let group: string | null = null,
      confirmedGroup = false,
      confirmedPerson = "";
    const enable = root.querySelector<HTMLButtonElement>(
      "[data-community-enable]",
    )!;
    const help = root.querySelector<HTMLAnchorElement>(
      "[data-community-help]",
    )!;
    const confirm = root.querySelector<HTMLButtonElement>(
      "[data-community-confirm]",
    )!;
    function refresh() {
      const person = stored<Person | null>("me", null);
      const joined = groupJoined(group) || confirmedGroup;
      const notified =
        remindersEnabled() ||
        (!!confirmedPerson && confirmedPerson === person?.id);
      void updateCommunity(root, joined, notified, () => {
        tabs[0].hidden = joined;
        tabs[1].hidden = notified;
        const visible = tabs.filter((tab) => !tab.hidden);
        root!.hidden = !visible.length;
        const list = root!.querySelector<HTMLElement>('[role="tablist"]')!;
        list.toggleAttribute("data-single", visible.length === 1);
        const current = tabs.findIndex(
          (tab) => !tab.hidden && tab.getAttribute("aria-selected") === "true",
        );
        select(current >= 0 ? current : tabs.indexOf(visible[0]));
      });
      const canEnable =
        !!person?.id &&
        "Notification" in window &&
        "PushManager" in window &&
        "serviceWorker" in navigator &&
        Notification.permission !== "denied";
      enable.hidden = !canEnable;
      const helpSlot = root!.querySelector<HTMLElement>(
        canEnable
          ? "#community-reminders .community-heading"
          : "#community-reminders .community-action",
      )!;
      if (help.parentElement !== helpSlot) helpSlot.append(help);
      help.className = canEnable ? "community-help" : "button button-gold";
      help.querySelector("span")!.textContent = canEnable
        ? "עזרה בהפעלת ההתראות"
        : "הגדרת התראות";
      help.title = canEnable ? "עזרה בהפעלת ההתראות" : "הגדרת התראות";
    }
    function select(index: number, focus = false) {
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        panels[i].hidden = i !== index;
      });
      if (focus) tabs[index].focus();
    }
    root.querySelector<HTMLElement>('[role="tablist"]')!.hidden = false;
    refresh();
    for (const event of [
      "storage",
      "pageshow",
      "df-account-change",
      "df-community-change",
      "df-reminders-change",
    ])
      window.addEventListener(event, refresh);
    void communityGroup()
      .then((url) => {
        group = url;
        const link = root.querySelector<HTMLAnchorElement>("[data-community]")!;
        if (url) {
          link.href = url;
          link.hidden = false;
          confirm.hidden = false;
        }
      })
      .catch(() => {})
      .finally(() => {
        const status = root.querySelector<HTMLElement>(
          "[data-community-status]",
        )!;
        status.hidden = !!group;
        if (!group)
          status.textContent =
            "קישור הקבוצה אינו זמין כרגע. אפשר לנסות שוב מאוחר יותר.";
        refresh();
      });
    confirm.addEventListener("click", () => {
      if (!group) return;
      confirmedGroup = true;
      confirmGroup(group);
      refresh();
    });
    enable.addEventListener("click", async () => {
      const status = root.querySelector<HTMLElement>(
        "[data-community-notification-status]",
      )!;
      enable.disabled = true;
      enable.querySelector("span")!.textContent = "בודקים ושומרים…";
      status.hidden = true;
      const account = stored<Person | null>("me", null)?.id || "";
      try {
        await enableReminders();
        confirmedPerson = account;
        if (account === stored<Person | null>("me", null)?.id)
          enable.querySelector("path")!.setAttribute("d", "m5 12 4 4 10-10");
        refresh();
      } catch {
        status.textContent =
          "הבקשה לא אושרה. בדקו את הרשאת ההתראות והחיבור ונסו שוב.";
        status.hidden = false;
      } finally {
        enable.disabled = false;
        enable.querySelector("span")!.textContent = "הפעלת התראות";
      }
    });
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(index));
      tab.addEventListener("keydown", (event) => {
        let next: number;
        const visible = tabs
          .map((tab, i) => (tab.hidden ? -1 : i))
          .filter((i) => i >= 0);
        if (event.key === "Home") next = visible[0];
        else if (event.key === "End") next = visible[visible.length - 1];
        else if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
          const rtl = getComputedStyle(root).direction === "rtl";
          const forward = event.key === (rtl ? "ArrowLeft" : "ArrowRight");
          next =
            visible[
              (visible.indexOf(index) + (forward ? 1 : -1) + visible.length) %
                visible.length
            ];
        } else return;
        event.preventDefault();
        select(next, true);
      });
    });
  }
</script>
