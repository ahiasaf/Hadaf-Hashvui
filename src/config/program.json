  "CONTENT": {
    "taanit-1": {
      "title": "מאימתי מזכירין גבורות גשמים",
      "deck": {
        "dir": "slides/taanit-1",
        "n": 10
      },
      "slides": [
        {
          "k": "שער",
          "h": "מסכת תענית · דף ב",
          "t": "פרק ראשון, מאימתי"
        },
        {
          "k": "איפה אנחנו",
          "h": "פותחים את המסכת",
          "t": "מסכת תענית נפתחת בשאלה מתי מתחילים להזכיר את הגשם בתפילה, ומשם היא תיקח אותנו אל כל עולם התענית והתפילה על הגשמים."
        },
        {
          "k": "המשנה",
          "h": "מאימתי מזכירין גבורות גשמים?",
          "t": "רבי אליעזר אומר: מיום טוב הראשון של חג.\nרבי יהושע אומר: מיום טוב האחרון של חג."
        },
        {
          "k": "השאלה",
          "h": "למה דווקא \"גבורות\"?",
          "t": "הגמרא עוצרת על הלשון. למה המשנה קוראת לגשם \"גבורות\" ולא פשוט \"גשמים\"?"
        },
        {
          "k": "תשובה",
          "h": "אמר רבי יוחנן: מפני שיורדין בגבורה",
          "t": "הגשם אינו אירוע טבעי שגרתי. הוא ירידה של כוח מלמעלה, ולכן הלשון היא לשון גבורה."
        },
        {
          "k": "איפה בתפילה",
          "h": "בברכת תחיית המתים",
          "t": "הזכרת הגשם נקבעה דווקא בברכה השנייה של שמונה עשרה, ברכת תחיית המתים."
        },
        {
          "k": "למה שם",
          "h": "שלושה מפתחות",
          "t": "הגמרא מלמדת ששלושה מפתחות לא נמסרו לשליח: מפתח של גשמים, מפתח של חיה, ומפתח של תחיית המתים.\nהגשם שייך לאותה משפחה, הוא החזרת החיים אל האדמה."
        },
        {
          "k": "לחשוב",
          "h": "הגשם כתחייה",
          "t": "שדה יבש שנראה מת, ואחרי הגשם הוא ירוק. לכן הזכרת הגשם יושבת בדיוק בברכה שמדברת על החזרת החיים."
        },
        {
          "k": "",
          "h": "",
          "t": ""
        },
        {
          "k": "",
          "h": "",
          "t": ""
        }
      ]
    },
    "megila-1": {
      "title": "מתי קוראים את המגילה, ולמה?",
      "deck": {
        "dir": "slides/megila-1",
        "n": 12
      },
      "slides": [
        {
          "k": "שער",
          "h": "מסכת מגילה · דף ב",
          "t": "פרק ראשון, מגילה נקראת"
        },
        {
          "k": "איפה אנחנו",
          "h": "פותחים את המסכת",
          "t": "המסכת נפתחת בשאלה שנראית טכנית, באיזה יום קוראים את המגילה, ומגלה מאחוריה תקנה שלמה של אנשי כנסת הגדולה."
        },
        {
          "k": "המשנה",
          "h": "מגילה נקראת באחד עשר, בשנים עשר, בשלושה עשר, בארבעה עשר, בחמישה עשר",
          "t": "לא פחות ולא יותר. חמישה תאריכים אפשריים, וכל מקום לפי מה שהוא."
        },
        {
          "k": "השאלה",
          "h": "למה לא תאריך אחד לכולם?",
          "t": "אם זה חג אחד, מדוע יש חמישה ימים שונים שבהם אפשר לקרוא?"
        },
        {
          "k": "החלוקה",
          "h": "מוקפות חומה מול שאר המקומות",
          "t": "כרכים המוקפין חומה מימות יהושע בן נון, קוראים בחמישה עשר.\nכפרים ועיירות גדולות, קוראים בארבעה עשר."
        },
        {
          "k": "החידוש",
          "h": "הכפרים מקדימין ליום הכניסה",
          "t": "בני הכפרים הורשו להקדים ליום שני או חמישי, ימי הכניסה, שבהם היו מתאספים בעיר."
        },
        {
          "k": "למה",
          "h": "כדי שאיש לא יישאר בחוץ",
          "t": "התקנה נבנתה סביב מי שקשה לו להגיע. במקום לדרוש מהכפרי לעזוב הכול ולבוא, הביאו את המגילה אל היום שבו הוא כבר נמצא בעיר."
        },
        {
          "k": "לחשוב",
          "h": "תקנה שמתכופפת אל האדם",
          "t": "חז\"ל לא ויתרו על קריאת המגילה, ולא ויתרו על בני הכפרים. הם שינו את התאריך כדי שכולם יהיו בפנים."
        },
        {
          "k": "",
          "h": "",
          "t": ""
        },
        {
          "k": "",
          "h": "",
          "t": ""
        }
      ]
    }
