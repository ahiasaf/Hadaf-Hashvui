{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "api/**/*",
    "astro.config.mjs"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/shared", "src/config", "src/features", "src/service-worker.js"
  ]
}
