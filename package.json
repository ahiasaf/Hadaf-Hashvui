{
  "name": "hadaf-hashvui",
  "private": true,
  "version": "9.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node tools/build-site.mjs",
    "preview": "node tools/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint src tools/*.mjs api tests && node tools/check-legacy.mjs",
    "format": "prettier --write src api tests tools/*.mjs astro.config.mjs eslint.config.mjs package.json .github/workflows/check.yml docs/architecture.md README.md",
    "format:check": "prettier --check src api tests tools/*.mjs astro.config.mjs eslint.config.mjs package.json .github/workflows/check.yml docs/architecture.md README.md",
    "check": "astro check",
    "prebuild": "node tools/prepare.mjs",
    "predev": "node tools/prepare.mjs",
    "precheck": "node tools/prepare.mjs",
    "test:browser": "node tools/browser-check.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@neondatabase/serverless": "^1.2.0",
    "astro": "^7.3.8",
    "oxc-transform-react": "^0.145.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "html-minifier-terser": "^7.2.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "@vitejs/plugin-react": "6.1.1"
  }
}
