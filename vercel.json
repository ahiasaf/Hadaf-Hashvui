{
  "cleanUrls": true,
  "rewrites": [],
  "headers": [
    {
      "source": "/(sw.js|data.js|links.js|net.js|net-config.js|media.js|mobile.css|manifest.json|join-manifest.json|admin-manifest.json|studio-manifest.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(scripts|tool-styles)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(_astro|media|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(slides|sfarim|daf|chav|m|mh|weekpics|joinpics|guidepics|flyer)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "functions": {
    "api/*.ts": {
      "maxDuration": 20
    }
  }
}
