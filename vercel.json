{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(join-manifest.json|index.html|admin.html|learn.html|rights.html|accessibility.html|info.html|slidetest.html|lab.html|voicetest.html|tzevet.html|masa.html|masa.js|tiul.html|data.js|links.js|stage.js|learned.js|textedit.js|a11y.js|deck.js|qr.js|join.html|board.html|sw.js)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/(slides|sfarim|daf)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
